# Copy to .env (used by apps/api)
DATABASE_URL=postgres://urbivue:urbivue@localhost:5432/urbivue
JWT_SECRET=change-me-in-production
PORT=3000
SEED_ADMIN_EMAIL=admin@urbivue.local
SEED_ADMIN_PASSWORD=urbivue-admin

# Telemetry ingestion
INGEST_API_KEY=urbivue-dev-ingest
MQTT_URL=mqtt://localhost:1883
# DISABLE_MQTT=true

# Notification channels (log channel is always on)
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100123456
