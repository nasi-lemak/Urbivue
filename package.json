{
  "name": "urbivue",
  "private": true,
  "description": "Unified city infrastructure management platform",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @urbivue/api migrate",
    "db:seed": "pnpm --filter @urbivue/api seed",
    "dev:api": "pnpm --filter @urbivue/api dev",
    "dev:web": "pnpm --filter @urbivue/web dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
